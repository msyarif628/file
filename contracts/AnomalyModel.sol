pragma solidity ^0.8.29;

import {ModelWeights} from "./ModelWeights.sol";

/// @title AnomalyModel — the on-chain neural network at the heart of Sentinel.
/// @notice A tiny quantized 4 -> 4 -> 1 MLP, pure fixed point (scale 1e4).
///         It runs INSIDE the reactive contract's react(): the network — not
///         an off-chain bot — decides whether a vault outflow pattern is a
///         drain. This is what makes Sentinel a "Reactive Meets AI" entry:
///         without this model, no pause ever happens.
///
///         Architecture: 4 standardized inputs -> 4 tanh hidden units ->
///         1 sigmoid output, returned as basis points (0..10000).
///         Weights/biases/standardization constants live in ModelWeights.sol
///         and are generated by ml/train.py — never hand-edited.
///
///         Activations use piecewise-linear lookup tables (33 points each).
///         The trainer (ml/train.py) contains an EXACT integer replica of
///         this code — same tables, same truncating division — so the
///         exported test vectors (ml/vectors.json) match this contract.
library AnomalyModel {
    int256 internal constant SCALE = 10000;

    // tanh table: z in [-4, 4], step 0.25 (33 points), values * 1e4.
    int256 internal constant TANH_MIN = -40000;
    int256 internal constant TANH_STEP = 2500;
    int256 internal constant SIG_MIN = -80000;
    int256 internal constant SIG_STEP = 5000;

    function _tanhTable(uint256 i) private pure returns (int256) {
        int256[33] memory t = [
            int256(-9993), int256(-9989), int256(-9982), int256(-9970), int256(-9951), int256(-9919), int256(-9866), int256(-9780),
            int256(-9640), int256(-9414), int256(-9051), int256(-8483), int256(-7616), int256(-6351), int256(-4621), int256(-2449),
            int256(0), int256(2449), int256(4621), int256(6351), int256(7616), int256(8483), int256(9051), int256(9414),
            int256(9640), int256(9780), int256(9866), int256(9919), int256(9951), int256(9970), int256(9982), int256(9989),
            int256(9993)
        ];
        return t[i];
    }

    // sigmoid table: z in [-8, 8], step 0.5 (33 points), values 0..10000.
    function _sigmoidTable(uint256 i) private pure returns (int256) {
        int256[33] memory t = [
            int256(3), int256(6), int256(9), int256(15), int256(25), int256(41), int256(67), int256(110),
            int256(180), int256(293), int256(474), int256(759), int256(1192), int256(1824), int256(2689), int256(3775),
            int256(5000), int256(6225), int256(7311), int256(8176), int256(8808), int256(9241), int256(9526), int256(9707),
            int256(9820), int256(9890), int256(9933), int256(9959), int256(9975), int256(9985), int256(9991), int256(9994),
            int256(9997)
        ];
        return t[i];
    }

    /// @notice Piecewise-linear interpolation over a lookup table.
    /// @dev Mirrors ml/train.py `_interp_table` exactly, including Solidity's
    ///      truncating division (negative numerators truncate toward zero).
    function _interp(int256 x, int256 lo, int256 step, bool isTanh) private pure returns (int256) {
        uint256 last = 32;
        if (x <= lo) return isTanh ? _tanhTable(0) : _sigmoidTable(0);
        int256 hi = lo + step * int256(last);
        if (x >= hi) return isTanh ? _tanhTable(last) : _sigmoidTable(last);
        uint256 idx = uint256((x - lo) / step);
        int256 rem = (x - lo) - int256(idx) * step;
        int256 y0 = isTanh ? _tanhTable(idx) : _sigmoidTable(idx);
        int256 y1 = isTanh ? _tanhTable(idx + 1) : _sigmoidTable(idx + 1);
        return y0 + ((y1 - y0) * rem) / step;
    }

    function _tanh(int256 x) internal pure returns (int256) {
        return _interp(x, TANH_MIN, TANH_STEP, true);
    }

    function _sigmoid(int256 x) internal pure returns (int256) {
        return _interp(x, SIG_MIN, SIG_STEP, false);
    }

    /// @notice Score one outflow event. Inputs are the RAW fixed-point
    ///         features (scale 1e4) exactly as SentinelReactive computes them:
    ///         f1 = log-scaled single amount, f2 = window outflow count,
    ///         f3 = log-scaled cumulative window outflow, f4 = new recipient.
    /// @return score Anomaly score in basis points: 0 (benign) .. 10000 (drain).
    function score(int256 f1, int256 f2, int256 f3, int256 f4) internal pure returns (uint256) {
        // Standardize: x_i = (f_i - MEAN_i) * SCALE / STD_i.
        int256[4] memory f = [f1, f2, f3, f4];
        int256[4] memory means = [ModelWeights.MEAN_F1, ModelWeights.MEAN_F2, ModelWeights.MEAN_F3, ModelWeights.MEAN_F4];
        int256[4] memory stds = [ModelWeights.STD_F1, ModelWeights.STD_F2, ModelWeights.STD_F3, ModelWeights.STD_F4];
        int256[4] memory x;
        for (uint256 i = 0; i < 4; i++) {
            x[i] = ((f[i] - means[i]) * SCALE) / stds[i];
        }

        // Hidden layer: h_j = tanh(sum_i W1[j][i] * x_i / SCALE + b1[j]).
        int256[4] memory b1 = [ModelWeights.B1_0, ModelWeights.B1_1, ModelWeights.B1_2, ModelWeights.B1_3];
        int256[4] memory h;
        for (uint256 j = 0; j < 4; j++) {
            int256[4] memory w = ModelWeights.w1Row(j);
            int256 acc = b1[j];
            for (uint256 i = 0; i < 4; i++) {
                acc += (w[i] * x[i]) / SCALE;
            }
            h[j] = _tanh(acc);
        }

        // Output layer: z = sum_j W2[j] * h_j / SCALE + b2; score = sigmoid(z).
        int256[4] memory w2 = [ModelWeights.W2_0, ModelWeights.W2_1, ModelWeights.W2_2, ModelWeights.W2_3];
        int256 z = ModelWeights.B2;
        for (uint256 j = 0; j < 4; j++) {
            z += (w2[j] * h[j]) / SCALE;
        }
        int256 s = _sigmoid(z);
        if (s < 0) return 0;
        if (s > 10000) return 10000;
        return uint256(s);
    }
}
